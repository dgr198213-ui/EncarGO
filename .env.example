# Supabase — Project Settings > API en tu proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service role key: SOLO para el servidor. Salta las Row Level Security policies,
# así que nunca debe llegar al cliente ni committearse. Cada ruta filtra a mano
# por req.usuarioId (ver server/auth.ts) para no depender de RLS aquí.
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del backend en local. En Railway se ignora — Railway inyecta su
# propio PORT automáticamente.
PORT=3001
NODE_ENV=development

# Dominios permitidos para llamar a esta API, separados por coma (sin barra
# final). En local se puede dejar vacío (permite cualquier origen). En
# producción: la URL de Vercel del frontend.
# Ejemplo: CORS_ORIGIN=https://encar-go.vercel.app
CORS_ORIGIN=

# Analista de Intake — mismo patrón de proveedores gratuitos que Creative AI Engine
GEMINI_API_KEY=
ZAI_API_KEY=

# Router multi-IA — Fase 4: webhook "Catch Hook" de un Zap ya configurado
ZAPIER_WEBHOOK_URL=

# Cliente (Vite) — anon key, segura de exponer en el navegador porque respeta RLS
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=

# URL base de la API en producción, CON el sufijo /api (Railway).
# En local se puede dejar vacía: Vite la sustituye por el proxy a
# http://localhost:3001 (ver vite.config.ts).
# Ejemplo: VITE_API_URL=https://encargo-api-production.up.railway.app/api
VITE_API_URL=
